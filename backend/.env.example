# AeroSync Backend — Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Server port
PORT=9001

# Allowed client origins (comma-separated for multiple, or single URL)
CLIENT_URL=http://localhost:9000

# Node environment: development | production
NODE_ENV=development

# Database connection string (required for PostgreSQL in production/staging; fallback to SQLite if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/aerosync?schema=public


# OpenSky API Credentials (optional, increases rate limit)
OPENSKY_USERNAME=your_username_here
OPENSKY_PASSWORD=your_password_here
